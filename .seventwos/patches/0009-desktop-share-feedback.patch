+
+import React, { useCallback, useEffect, useRef, useState } from "react";
+import { IconButton, Tooltip } from "@vector-im/compound-web";
+
+import ContextMenu, { alwaysAboveRightOf, ChevronFace, useContextMenu } from "../../structures/ContextMenu";
+import AccessibleButton from "../elements/AccessibleButton";
+import PlatformPeg from "../../../PlatformPeg";
+
+const FEEDBACK_ENDPOINT = "https://seventwos.com/connect/api/desktop/feedback";
+const MAX_LENGTH = 2000;
+const MIN_LENGTH = 10;
+const VERSION_RE = /^[0-9A-Za-z._+-]{1,32}$/;
+
+type PlatformName = "windows" | "macos" | "linux";
+
+function detectPlatform(): PlatformName | undefined {
+    if (typeof navigator === "undefined") return undefined;
+    const ua = navigator.userAgent.toLowerCase();
+    if (ua.includes("win")) return "windows";
+    if (ua.includes("mac")) return "macos";
+    if (ua.includes("linux")) return "linux";
+    return undefined;
+}
+
+const HeartBubbleIcon: React.FC = () => (
+    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
+        <path d="M12 15.2l-2.6-2.5a1.85 1.85 0 0 1 2.6-2.6 1.85 1.85 0 0 1 2.6 2.6L12 15.2z" />
+    </svg>
+);
+
+export const ShareFeedbackButton: React.FC = () => {
+    const [menuDisplayed, handle, openMenu, closeMenu] = useContextMenu<HTMLButtonElement>();
+    const [text, setText] = useState("");
+    const [submitting, setSubmitting] = useState(false);
+    const [error, setError] = useState<string | null>(null);
+    const [submittedIssue, setSubmittedIssue] = useState<{ issueNumber: number; issueUrl: string } | null>(null);
+    const textareaRef = useRef<HTMLTextAreaElement | null>(null);
+
+    useEffect(() => {
+        if (menuDisplayed) {
+            setError(null);
+            setSubmittedIssue(null);
+            requestAnimationFrame(() => textareaRef.current?.focus());
+        }
+    }, [menuDisplayed]);
+
+    const handleSubmit = useCallback(async () => {
+        const trimmed = text.trim();
+        if (trimmed.length < MIN_LENGTH) {
+            setError(`Please enter at least ${MIN_LENGTH} characters.`);
+            return;
+        }
+        setSubmitting(true);
+        setError(null);
+        try {
+            let appVersion: string | undefined;
+            try {
+                const raw = await PlatformPeg.get()?.getAppVersion();
+                if (raw && VERSION_RE.test(raw)) appVersion = raw;
+            } catch {
+                appVersion = undefined;
+            }
+            const platform = detectPlatform();
+            const payload: { text: string; appVersion?: string; platform?: PlatformName } = { text: trimmed };
+            if (appVersion) payload.appVersion = appVersion;
+            if (platform) payload.platform = platform;
+
+            const resp = await fetch(FEEDBACK_ENDPOINT, {
+                method: "POST",
+                headers: { "Content-Type": "application/json" },
+                credentials: "omit",
+                body: JSON.stringify(payload),
+            });
+
+            if (resp.status === 201) {
+                const data = (await resp.json()) as { issueNumber?: number; issueUrl?: string };
+                setSubmittedIssue({
+                    issueNumber: data.issueNumber ?? 0,
+                    issueUrl: data.issueUrl ?? "",
+                });
+                setText("");
+                return;
+            }
+            if (resp.status === 429) {
+                setError("Too many feedback submissions. Please try again later.");
+            } else if (resp.status === 422) {
+                setError("Please remove any private tokens, keys, or internal addresses before sharing.");
+            } else if (resp.status === 503) {
+                setError("Feedback submission is not enabled yet.");
+            } else {
+                setError(`Could not submit feedback (HTTP ${resp.status}).`);
+            }
+        } catch {
+            setError("Network error while submitting feedback.");
+        } finally {
+            setSubmitting(false);
+        }
+    }, [text]);
+
+    const onKeyDown = useCallback(
+        (ev: React.KeyboardEvent<HTMLTextAreaElement>) => {
+            if ((ev.ctrlKey || ev.metaKey) && ev.key === "Enter" && !submitting) {
+                ev.preventDefault();
+                void handleSubmit();
+            }
+        },
+        [handleSubmit, submitting],
+    );
+
+    return (
+        <>
+            <Tooltip label="Share feedback" placement="right">
+                <IconButton
+                    ref={handle}
+                    aria-label="Share feedback"
+                    aria-expanded={menuDisplayed}
+                    onClick={openMenu}
+                    size="32px"
+                    className="mx_SpacePanel_shareFeedbackButton"
+                >
+                    <HeartBubbleIcon />
+                </IconButton>
+            </Tooltip>
+            {menuDisplayed && handle.current && (
+                <ContextMenu
+                    {...alwaysAboveRightOf(handle.current.getBoundingClientRect(), ChevronFace.None, 16)}
+                    wrapperClassName="mx_ShareFeedback_ContextMenuWrapper"
+                    data-testid="share-feedback-popover"
+                    onFinished={closeMenu}
+                    managed={false}
+                    focusLock={true}
+                    role="dialog"
+                    aria-label="Report a bug or suggest a feature"
+                >
+                    <div style={{ padding: "12px", width: "320px", display: "flex", flexDirection: "column", gap: "10px" }}>
+                        <h2 style={{ margin: 0, fontSize: "15px", fontWeight: 600 }}>Report a bug or suggest a feature</h2>
+                        {submittedIssue ? (
+                            <div style={{ display: "flex", flexDirection: "column", gap: "8px", fontSize: "13px" }}>
+                                <p style={{ margin: 0 }}>
+                                    Thanks! Created public issue{" "}
+                                    {submittedIssue.issueUrl ? (
+                                        <a href={submittedIssue.issueUrl} target="_blank" rel="noreferrer noopener">
+                                            #{submittedIssue.issueNumber}
+                                        </a>
+                                    ) : (
+                                        `#${submittedIssue.issueNumber}`
+                                    )}
+                                    .
+                                </p>
+                                <div style={{ display: "flex", justifyContent: "flex-end" }}>
+                                    <AccessibleButton kind="primary" onClick={closeMenu}>
+                                        Close
+                                    </AccessibleButton>
+                                </div>
+                            </div>
+                        ) : (
+                            <>
+                                <textarea
+                                    ref={textareaRef}
+                                    value={text}
+                                    onChange={(e) => setText(e.target.value)}
+                                    onKeyDown={onKeyDown}
+                                    placeholder="What feedback would you like to share?"
+                                    maxLength={MAX_LENGTH}
+                                    rows={4}
+                                    autoFocus
+                                    disabled={submitting}
+                                    style={{
+                                        width: "100%",
+                                        boxSizing: "border-box",
+                                        resize: "vertical",
+                                        padding: "8px",
+                                        borderRadius: "6px",
+                                        fontFamily: "inherit",
+                                        fontSize: "13px",
+                                    }}
+                                />
+                                <p style={{ margin: 0, fontSize: "12px", opacity: 0.8 }}>
+                                    This will be posted as a public GitHub issue.
+                                </p>
+                                {error && (
+                                    <p role="alert" style={{ margin: 0, fontSize: "12px", color: "var(--cpd-color-text-critical-primary, #c5221f)" }}>
+                                        {error}
+                                    </p>
+                                )}
+                                <div style={{ display: "flex", justifyContent: "flex-end", gap: "8px" }}>
+                                    <AccessibleButton kind="secondary" onClick={closeMenu} disabled={submitting}>
+                                        Cancel
+                                    </AccessibleButton>
+                                    <AccessibleButton kind="primary" onClick={() => void handleSubmit()} disabled={submitting}>
+                                        {submitting ? "Sending..." : "Share feedback"}
+                                    </AccessibleButton>
+                                </div>
+                            </>
+                        )}
+                    </div>
+                </ContextMenu>
+            )}
+        </>
+    );
+};
+
+export default ShareFeedbackButton;
