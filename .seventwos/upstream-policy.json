{
  "schemaVersion": 1,
  "policyId": "desktop-selective-upstream-v1",
  "repository": "seventwos-app/usr-workspace-desktop",
  "integrationModel": "desktop-shell-plus-in-repo-web-app",
  "upstream": {
    "repository": "element-hq/element-web",
    "assessmentBranch": "develop",
    "sourceUrl": "https://github.com/element-hq/element-web"
  },
  "protectedDivergence": {
    "description": "Seventwos UI, product identity, endpoint policy, authentication, storage, profile migration, and release behavior are repository-owned and must not be overwritten by upstream.",
    "pathMap": ".seventwos/upstream-path-map.json",
    "codeowners": "CODEOWNERS"
  },
  "ledger": {
    "path": ".seventwos/upstream-ledger.jsonl",
    "appendOnly": true
  },
  "webApp": {
    "path": "apps/web",
    "source": "in-repo",
    "upstreamBaseVersion": "1.12.27",
    "restoredFrom": "5aac88a17^",
    "build": "pnpm --filter element-web build"
  }
}
